{
  "name": "rulegraph",
  "version": "0.3.0",
  "description": "Compile Clash/mihomo rule sets into domain-trie, CIDR-prefix and Aho-Corasick indexes while preserving first-match semantics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaojiman/rulegraph.git"
  },
  "homepage": "https://github.com/chaojiman/rulegraph#readme",
  "bugs": {
    "url": "https://github.com/chaojiman/rulegraph/issues"
  },
  "author": "chaojiman",
  "bin": {
    "rulegraph": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx src/bench/main.ts",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "clash",
    "mihomo",
    "ruleset",
    "trie",
    "aho-corasick",
    "proxy"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}